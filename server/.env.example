# Copy this file to server/.env and fill in real values.
# NEVER commit the actual .env file or real secrets.

PORT=5000

# Generate a strong secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Required by `npm run seed` (creates the initial admin account).
# Leave ADMIN_PASSWORD empty to have a strong random password generated
# and printed once during seeding. If set, it must be >= 12 characters
# and NOT a known default.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Razorpay (TEST MODE) — leave empty to disable payment checkout.
# The app works perfectly without these; free plan is always available.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay recurring subscription plan IDs (created via Razorpay Dashboard).
# Format: RAZORPAY_PLAN_ID_<CURRENCY>_<INTERVAL>
# Example: RAZORPAY_PLAN_ID_INR_MONTHLY=plan_abc123
RAZORPAY_PLAN_ID_INR_MONTHLY=
RAZORPAY_PLAN_ID_INR_QUARTERLY=
RAZORPAY_PLAN_ID_INR_YEARLY=
