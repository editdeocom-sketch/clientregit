# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
dist/
client/dist/

# Database (local SQLite) — never commit user data or backups
data/*.db
data/*.db.previous
data/*.tmp
backups/
server/backups/

# Uploaded media
uploads/

# Environment files — never commit secrets
.env
.env.local
.env.*.local
.env.production
.env.development
server/.env
# Keep the safe template files tracked
!.env.example
!server/.env.example

# Logs
*.log
npm-debug.log*
stdout.log
stderr.log

# OS / editor
.DS_Store
.vscode/
.idea/
Thumbs.db

# Runtime
*.pid
